  description = Linking C executable $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = C:\Users\xwx\.pico-sdk\cmake\v3.31.5\bin\cmake.exe --regenerate-during-build -SE:\pico\pico -BE:\pico\pico\build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = C:\Users\xwx\.pico-sdk\ninja\v1.12.1\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = C:\Users\xwx\.pico-sdk\ninja\v1.12.1\ninja.exe -t targets
  description = All primary targets available:

