.program swd_read
.side_set 1

; TX FIFO: request byte in bits 7:0 (LSB first)
; RX FIFO: ACK first, then 32-bit data, then parity bit
.wrap_target
    pull block        side 1
    set x, 7          side 1
request_loop:
    out pins, 1       side 0
    jmp x-- request_loop side 1

    ; One turnaround cycle: host releases SWDIO, target takes ownership.
    set pindirs, 0    side 0
    nop               side 1

    set x, 2          side 0
ack_loop:
    in pins, 1        side 1
    jmp x-- ack_loop  side 0
    push block        side 0

    set x, 31         side 0
data_loop:
    in pins, 1        side 1
    jmp x-- data_loop side 0
    push block        side 0

    in pins, 1        side 1
    push block        side 0

    ; Turnaround back to host and leave the bus high.
    nop               side 0
    set pindirs, 1    side 1
    set pins, 1       side 1
.wrap
